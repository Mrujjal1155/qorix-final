# QORIX reseller API settings
# Reseller Panel → API key tab থেকে key কপি করুন
QORIX_API=https://qorixlab.com/api/public/reseller/v1
QORIX_KEY=qxr_your_api_key_here

# আপনার নিজের সাইটের মার্জিন (1.25 = 25% বেশি দামে বিক্রি)
MARKUP=1.25

# লোকাল সার্ভার পোর্ট
PORT=3000

# Telegram bot চালালে (telegram-bot.mjs)
BOT_TOKEN=
